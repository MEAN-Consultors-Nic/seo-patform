# --- API (NestJS) ---
NODE_ENV=development
API_PORT=3000
API_GLOBAL_PREFIX=api

# --- MongoDB ---
MONGODB_URI=mongodb://mongo:27017/seo-platform
MONGO_INITDB_DATABASE=seo-platform
MONGO_EXPRESS_PORT=8081

# --- SMTP (gmail, sendgrid, mailgun, etc) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Joseph O. — Media Spearhead
SMTP_FROM_EMAIL=joseph.o@mediaspearhead.com

# --- Web (Angular) ---
WEB_PORT=4200
API_BASE_URL=http://localhost:3000/api
# Public base URL used to build share links in emails (no trailing slash)
PUBLIC_WEB_URL=http://localhost:4200
