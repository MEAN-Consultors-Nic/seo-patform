# --- pnpm settings ---
# Nx (and several Angular/Nest tools) assume a hoisted node_modules layout.
# shamefully-hoist replicates that flat layout instead of pnpm's isolated store.
shamefully-hoist=true

# Avoid blocking install on peer-dep gripes; pnpm 10+ is strict by default.
auto-install-peers=true
strict-peer-dependencies=false

# --- npm fallback (kept for tools that read npm config) ---
legacy-peer-deps=true
