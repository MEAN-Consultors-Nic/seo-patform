  "scripts": {
    "dev": "nx run-many -t serve -p api,web --parallel=2",
    "dev:api": "nx serve api",
    "dev:web": "nx serve web",
    "db:up": "docker compose up -d mongo mongo-express",
    "db:down": "docker compose stop mongo mongo-express",
    "db:logs": "docker compose logs -f mongo",
    "dev:all": "npm run db:up && npm run dev",
    "build": "nx run-many -t build -p api,web --parallel=2",
    "build:api": "nx build api --configuration=production",
    "build:web": "nx build web --configuration=production",
    "start": "node dist/apps/api/main.js",
    "heroku-postbuild": "pnpm build:api",
    "lint": "nx run-many -t lint --parallel=4",
    "test": "nx run-many -t test --parallel=4",
    "typecheck": "nx run-many -t typecheck --parallel=4"
  },
